# ---- Backend (apps/api) ----
# Free key from https://rebrickable.com/api/  (Account -> Settings -> API)
# Required to import set inventories.
REBRICKABLE_API_KEY=

# SQLite database location (relative to apps/api/prisma)
DATABASE_URL="file:./dev.db"

PORT=3001
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Brickognize (public, no auth). Be polite: keep the throttle on.
BRICKOGNIZE_BASE_URL=https://api.brickognize.com
BRICKOGNIZE_MIN_INTERVAL_MS=700
