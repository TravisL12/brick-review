generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person with their own collection. Everything a user "owns" hangs off this row;
/// the catalogue caches (Minifig, MinifigPart, PartAlias, ColorAlias) are deliberately
/// global, because they are just a local mirror of Rebrickable and cost rate-limited
/// requests to rebuild per account.
model User {
  id           String   @id @default(cuid())
  /// Stored lower-cased; the app compares emails case-insensitively.
  email        String   @unique
  passwordHash String
  displayName  String?
  /// user | admin. The first account to register becomes admin.
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sets  LegoSet[]
  scans ScanEvent[]
}

/// A LEGO set a user owns / has declared.
model LegoSet {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Canonical Rebrickable set number, always suffixed: "10276-1".
  /// Unique per user, not globally — two people can own the same set.
  setNum           String
  name             String?
  year             Int?
  themeId          Int?
  themeName        String?
  numParts         Int?
  imgUrl           String?
  /// Brickset's internal numeric set id, cached so image syncs skip the lookup call.
  bricksetId       Int?
  /// pending | syncing | ready | error
  syncStatus       String    @default("pending")
  syncError        String?
  lastSyncedAt     DateTime?
  /// When the minifig list was last pulled. Null means "never asked", which is what
  /// separates a set with genuinely no minifigs from one synced before they existed.
  minifigsSyncedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parts    SetPart[]
  images   SetImage[]
  minifigs SetMinifig[]

  @@unique([userId, setNum])
  @@index([userId])
  @@index([syncStatus])
}

/// One picture of a set. The Rebrickable box shot is sortOrder 0; Brickset's
/// additional images (alternate angles, build shots) follow.
model SetImage {
  id    String  @id @default(cuid())
  setId String
  set   LegoSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  /// Full-resolution image URL.
  url       String
  /// Source-provided thumbnail, when there is one. Rebrickable URLs are resized
  /// client-side via its /media/thumbs/ transform instead, so they leave this null.
  thumbUrl  String?
  /// "rebrickable" | "brickset"
  source    String
  sortOrder Int     @default(0)

  @@unique([setId, url])
  @@index([setId, sortOrder])
}

/// One minifigure that ships with a set. Rebrickable models figs as their own
/// mini-sets ("fig-002544"), so the fig number is a set number in its catalogue.
model SetMinifig {
  id    String  @id @default(cuid())
  setId String
  set   LegoSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  /// Rebrickable fig number, e.g. "fig-002544"
  figNum   String
  name     String?
  imgUrl   String?
  quantity Int     @default(1)

  @@unique([setId, figNum])
  @@index([figNum])
  @@index([setId])
}

/// A minifigure as a catalogue entry in its own right, cached the first time its
/// page is opened. `SetMinifig` stays the "which sets ship it" join; this holds
/// what Rebrickable knows about the fig itself.
model Minifig {
  id            String    @id @default(cuid())
  /// Rebrickable fig number, e.g. "fig-002544"
  figNum        String    @unique
  name          String?
  imgUrl        String?
  numParts      Int?
  /// When the fig's own parts inventory was pulled. Null means never, which is
  /// what makes the first page view fetch it and later ones read the cache.
  partsSyncedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parts MinifigPart[]
}

/// One line of a minifig's own parts inventory (torso, legs, hair, accessories).
model MinifigPart {
  id        String  @id @default(cuid())
  minifigId String
  minifig   Minifig @relation(fields: [minifigId], references: [id], onDelete: Cascade)

  partNum   String
  name      String?
  imgUrl    String?
  colorId   Int?
  colorName String?
  colorHex  String?
  quantity  Int     @default(1)
  isSpare   Boolean @default(false)
  elementId String?

  @@unique([minifigId, partNum, colorId, isSpare])
  @@index([partNum])
  @@index([minifigId])
}

/// One line of a set's parts inventory.
model SetPart {
  id    String  @id @default(cuid())
  setId String
  set   LegoSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  /// Rebrickable part number, e.g. "3001"
  partNum   String
  name      String?
  imgUrl    String?
  colorId   Int?
  colorName String?
  colorHex  String?
  quantity  Int     @default(1)
  isSpare   Boolean @default(false)
  elementId String?

  @@unique([setId, partNum, colorId, isSpare])
  @@index([partNum])
  @@index([setId])
}

/// Maps an external catalog id (BrickLink / LEGO / BrickOwl) to a Rebrickable part number.
/// Brickognize returns BrickLink-style ids, so this is the join bridge.
model PartAlias {
  id         String @id @default(cuid())
  /// "BrickLink" | "LEGO" | "BrickOwl" | "Rebrickable" | ...
  source     String
  externalId String
  partNum    String

  @@unique([source, externalId, partNum])
  @@index([externalId])
  @@index([partNum])
}

/// Audit trail of recognitions, so we can improve matching / send feedback later.
model ScanEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String?
  /// part | set | fig | sticker
  searchType  String
  /// JSON blob of the raw Brickognize candidate list
  candidates  String
  topPartNum  String?
  topScore    Float?
  matchedSets String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Maps a Rebrickable colour id to its BrickLink equivalent, so part links can
/// deep-link to the right colour. Populated once from Rebrickable's colour table.
model ColorAlias {
  /// Rebrickable colour id
  id          Int      @id
  name        String
  rgb         String?
  bricklinkId Int?
  updatedAt   DateTime @updatedAt
}

/// A well-known set shown on the signed-out splash screen.
///
/// Deliberately its own table rather than a query over `LegoSet`: the splash is
/// public, and picking images out of the collection would leak whatever sets a
/// real account happens to own to anybody who loads the sign-in page. These rows
/// are pure Rebrickable catalogue data belonging to nobody, refreshed from a
/// curated list of set numbers hard-coded in SplashService.
model ShowcaseSet {
  /// Canonical Rebrickable set number, e.g. "75192-1"
  setNum    String   @id
  name      String?
  year      Int?
  themeName String?
  numParts  Int?
  imgUrl    String?
  /// Position in the curated list, so the splash renders in a stable order.
  sortOrder Int      @default(0)
  fetchedAt DateTime @default(now())

  @@index([sortOrder])
}
